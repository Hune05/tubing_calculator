<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_summary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/summary_title"
        android:text="오늘 · 10월 5일 (월)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:id="@+id/sum_tile_1"
        android:background="@drawable/widget_tile_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/summary_dot_schedule"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_warn" />

            <TextView
                android:id="@+id/lbl_schedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/widget_row_schedule"
                android:textColor="@color/widget_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/summary_value_schedule"
        android:text="1건 남음"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/summary_dot_reports"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_warn" />

            <TextView
                android:id="@+id/lbl_reports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/widget_row_reports"
                android:textColor="@color/widget_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/summary_value_reports"
        android:text="1곳 안 씀"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/summary_dot_stock"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_warn" />

            <TextView
                android:id="@+id/lbl_stock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/widget_row_stock"
                android:textColor="@color/widget_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/summary_value_stock"
        android:text="부족 1건"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/summary_dot_attendance"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_ok" />

            <TextView
                android:id="@+id/lbl_attendance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/widget_row_attendance"
                android:textColor="@color/widget_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/summary_value_attendance"
        android:text="정상근무"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/summary_updated"
        android:text="09:34 기준"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:textColor="@color/widget_sub"
        android:textSize="10sp" />
</LinearLayout>
