<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sch_label"
            android:textColor="@color/widget_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sch_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="오늘 3건"
            android:textColor="@color/widget_pt_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sch_r1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_t1"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_pt_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sch_x1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="오늘 · 10월 5일 (월)"
            android:textColor="@color/widget_sub"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sch_r2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_t2"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="09:00"
            android:textColor="@color/widget_pt_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sch_x2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="압력시험 라인 점검"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="normal" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sch_r3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_t3"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="13:30"
            android:textColor="@color/widget_pt_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sch_x3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="자재 입고 확인"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="normal" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sch_r4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_t4"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_pt_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sch_x4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="안전 교육 (종일)"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="normal" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sch_r5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_t5"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_pt_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sch_x5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="내일 · 10월 6일 (화)"
            android:textColor="@color/widget_sub"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sch_r6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_t6"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="08:30"
            android:textColor="@color/widget_pt_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sch_x6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="배관 서포트 설치"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="normal" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sch_r7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sch_t7"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="14:00"
            android:textColor="@color/widget_pt_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sch_x7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="시운전 협의"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="normal" />
    </LinearLayout>

    <TextView
        android:id="@+id/sch_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="@color/widget_sub"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
