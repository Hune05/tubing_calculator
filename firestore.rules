rules_version = '2';

// Firestore 권한 규칙 (2026-09-24).
//
// ⚠️ 올리기 전에 먼저 확인할 것
//   이 규칙은 "로그인한 사람만" 읽고 쓰게 한다. "이름만 넣고 시작"한 사람은 익명 로그인으로
//   uid를 받으므로, Firebase 콘솔 → Authentication → 로그인 방법에서 "익명"이 켜져 있어야 한다.
//   꺼진 채로 이 규칙을 올리면 구글 로그인을 안 한 사람은 서버를 전혀 못 쓴다.
//   firebase.json에는 일부러 연결하지 않았다(`firebase deploy`로 함수만 올리다가 규칙이
//   같이 올라가지 않게). 콘솔 → Firestore → 규칙에 붙여 넣어 올린다.
//
// 무엇을 막나
//   - users/{이름}: 문서에 적힌 uid의 주인만 고친다(남의 이름으로 사진·연락처·알림 토큰을
//     바꾸지 못하게). uid가 안 적힌 옛 문서는 누구든 처음 쓰는 사람이 주인이 된다.
//   - inventory: ownerUid가 있으면 그 사람만 고치고 지운다. 없으면(공용) 누구나.
//   - 프로젝트(my_projects)·튜브/형강 컷팅 작업·라인 틀·단계 틀: inventory와 같다(2026-09-25).
//   - 잔재(cutting_leftovers)·설정(my_project_settings): 내 문서(…__uid)와 예전 공용 문서만 쓴다.
//   - 나머지 모음과 하위 모음: 로그인한 사람이면 읽고 쓴다(지금 앱이 쓰는 그대로).
//
// 못 막는 것(앱이 가려 줌)
//   - 남의 개인 재고 "읽기". 앱이 재고 모음을 통째로 읽어 폰에서 거르기 때문에, 문서마다
//     읽기를 막으면 목록 전체가 안 열린다. 막으려면 앱 쿼리를 "공용 + 내 것" 두 번으로
//     나눠야 한다(docs/프로필_현업도구_비교_2026-09-24.md 6절).
//   - 서버 함수(functions/)는 관리자 권한이라 이 규칙과 상관없이 동작한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // 주인 칸이 없거나 비었으면 공용.
    function noOwner(data) {
      return !('ownerUid' in data) || data.ownerUid == null || data.ownerUid == '';
    }

    function ownerOk(data) {
      return noOwner(data) || data.ownerUid == me();
    }

    // 주인(ownerUid)을 두는 모음.
    function ownedColls() {
      return ['my_projects', 'cutting_projects', 'steel_cutting_projects',
              'cutting_line_templates', 'my_project_templates'];
    }

    // 위에서 따로 규칙을 정한 모음(나머지 규칙에서 뺀다).
    function specialColls() {
      return ownedColls().concat(['users', 'inventory', 'cutting_leftovers',
                                  'my_project_settings']);
    }

    // 사용자 문서에 주인 uid가 아직 안 적혔는지.
    function nameFree(data) {
      return !('uid' in data) || data.uid == null || data.uid == '';
    }

    match /users/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (nameFree(request.resource.data) || request.resource.data.uid == me());
      allow update: if signedIn()
        && (nameFree(resource.data) || resource.data.uid == me())
        && (nameFree(request.resource.data) || request.resource.data.uid == me());
      allow delete: if signedIn()
        && !nameFree(resource.data) && resource.data.uid == me();
    }

    match /inventory/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && ownerOk(request.resource.data);
      allow update: if signedIn()
        && ownerOk(resource.data) && ownerOk(request.resource.data);
      allow delete: if signedIn() && ownerOk(resource.data);
    }

    // 프로젝트·컷팅 작업·라인 틀·단계 틀(점검 25·26번)은 재고와 같다: 주인이 있으면 그
    // 사람만 고치고 지운다. 주인이 없거나 빈 글이면(예전 자료, "공용으로 돌리기") 누구나.
    // 그 밖의 모음은 로그인한 사람이면 읽고 쓴다. 따로 정한 모음(users·inventory·잔재·설정)은
    // 여기서 빼 둬야 그 규칙이 먹힌다(규칙은 하나라도 허락하면 통과).
    match /{coll}/{id} {
      allow read: if signedIn()
        && (coll in ownedColls() || !(coll in specialColls()));
      allow create: if signedIn()
        && ((coll in ownedColls() && ownerOk(request.resource.data))
            || !(coll in specialColls()));
      allow update: if signedIn()
        && ((coll in ownedColls() && ownerOk(resource.data)
             && ownerOk(request.resource.data))
            || !(coll in specialColls()));
      allow delete: if signedIn()
        && ((coll in ownedColls() && ownerOk(resource.data))
            || !(coll in specialColls()));
    }

    // 잔재: 사람마다 current__{uid}, 예전 공용 문서는 current(점검 26번).
    match /cutting_leftovers/{doc} {
      allow read: if signedIn();
      allow write: if signedIn() && (doc == 'current' || doc == 'current__' + me());
    }

    // 사람마다 두는 설정(이름__{uid}). 이름만인 문서는 예전에 같이 쓰던 것(점검 25번).
    match /my_project_settings/{doc} {
      allow read: if signedIn();
      allow write: if signedIn()
        && (!doc.matches('.*__.*') || doc.matches('.*__' + me()));
    }

    // 근태 기록(문서 이름 {uid}__{yyyy-MM-dd}) - 프로젝트와 무관하게 사람 기준이라
    // 자기 것만 읽고 쓴다(필드 헬퍼 4번).
    match /attendance_records/{doc} {
      allow read, write: if signedIn() && doc.split('__')[0] == me();
    }

    // 하위 모음(컷팅 기록·형강 변경 기록 등)은 로그인한 사람이면 읽고 쓴다.
    match /{coll}/{id}/{sub}/{rest=**} {
      allow read, write: if signedIn() && !(coll in ['users', 'inventory']);
    }
  }
}
