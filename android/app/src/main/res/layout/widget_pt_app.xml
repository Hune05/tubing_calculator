<?xml version="1.0" encoding="utf-8"?>
<!-- 압력 시험 위젯 큰 모양(10-15 다시 그림): 머리 줄(아이콘·이름·라인) · 상태 알약 · 큰 경과 시간(칸에 맞춰 줄어듦)
     · 진행 막대 · 남은 시간 · 시작/완료 시각. 색은 앱 청록, 밝은/어두운 테마를 따른다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pta_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_icon_brand">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_gauge" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="@string/widget_pt_label"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pta_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_sub"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pta_status"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_pill_soft"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/widget_pt_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="36dp">

            <Chronometer
                android:id="@+id/pta_elapsed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pta_elapsed_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textStyle="bold" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/pta_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/pt_bar" />

        <ProgressBar
            android:id="@+id/pta_bar_done"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="1000"
            android:progress="1000"
            android:progressDrawable="@drawable/pt_bar_green"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pta_remain_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_pt_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/pta_remain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/widget_pt_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

            <TextView
                android:id="@+id/pta_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_sub"
                android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
